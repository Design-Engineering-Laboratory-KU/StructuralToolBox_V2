<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net7.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>StbGrasshopper</AssemblyName>
    <RootNamespace>StbGrasshopper</RootNamespace>
    <LangVersion>latest</LangVersion>
    <TargetExt>.gha</TargetExt>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- GH_Component.Icon requires System.Drawing.Bitmap. Rhino/Grasshopper
         provides the supported host environment on each target platform. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <!-- The version comes from the VERSION file at the repository root. -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../VERSION').Trim())</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Compile against the Rhino 8 SR32 SDK (not the locally installed Rhino)
         so the plugin loads on Rhino 8 SR32 and later on Windows and macOS. -->
    <RhinoSdkVersion Condition="'$(RhinoSdkVersion)' == ''">8.32.26160.13001</RhinoSdkVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" PrivateAssets="all" />
    <!-- Reference only: Rhino supplies its platform-specific Windows Forms
         implementation at runtime on both Windows and macOS. -->
    <PackageReference Include="Microsoft.WindowsDesktop.App.Ref"
                      Version="7.0.20"
                      GeneratePathProperty="true"
                      ExcludeAssets="all"
                      PrivateAssets="all" />
    <EmbeddedResource Include="Resources\Icons\*.png" />
    <Reference Include="System.Windows.Forms">
      <HintPath>$(PkgMicrosoft_WindowsDesktop_App_Ref)\ref\net7.0\System.Windows.Forms.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Reference only: Rhino supplies RhinoCommon / Grasshopper / GH_IO at runtime. -->
    <PackageReference Include="Grasshopper" Version="$(RhinoSdkVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="RhinoCommon" Version="$(RhinoSdkVersion)" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <GrasshopperLibrariesPath Condition="'$(GrasshopperLibrariesPath)' == ''">$(APPDATA)\Grasshopper\Libraries</GrasshopperLibrariesPath>
  </PropertyGroup>

  <Target Name="CopyGhaToGrasshopperLibraries"
          AfterTargets="Build"
          Condition="'$(OS)' == 'Windows_NT'">
    <MakeDir Directories="$(GrasshopperLibrariesPath)" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(GrasshopperLibrariesPath)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
